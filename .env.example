# ================================
# QAU-smartAI 环境变量配置
# 复制此文件为 .env 并填入实际值
# .env 文件已被 .gitignore 忽略，不会提交到 Git
# ================================

# ================================
# 必需配置 - 请替换为您的实际密钥
# ================================

# 阿里云百炼 AI (DashScope)
DASHSCOPE_API_KEY=<your-dashscope-api-key>
# Spring AI 2.0 底层用官方 openai-java SDK，base-url 必须带上 /v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# 需与 spring.ai.vectorstore.pgvector.dimensions 及 document_chunk.embedding 保持一致
DASHSCOPE_EMBEDDING_DIMS=1536

# ================================
# 数据库配置
# ================================

# PostgreSQL（与 docker-compose.yml 对齐）
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=qau_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-postgres-password>

# Redis（与 docker-compose.yml 对齐）
REDIS_HOST=localhost
REDIS_PORT=16380
REDIS_PASSWORD=<your-redis-password>

# ================================
# 对象存储配置（可选）
# ================================

# 阿里云 OSS
OSS_ENDPOINT=<your-oss-endpoint>
OSS_ACCESS_KEY_ID=<your-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-access-key-secret>
OSS_BUCKET_NAME=<your-bucket-name>

# 或使用 MinIO / RustFS 本地存储（S3 兼容）
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_BUCKET=qau-smartai
